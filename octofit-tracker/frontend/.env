# Frontend environment variables for Octofit Tracker
# 
# VITE_CODESPACE_NAME: Required for Codespaces support
# When running in Codespaces, set this to your Codespace name
# to build the correct API URL: https://${VITE_CODESPACE_NAME}-8000.app.github.dev
#
# For local development, this can be left unset to use http://localhost:8000

# Local development (no Codespaces)
VITE_API_BASE_URL=http://localhost:8000

